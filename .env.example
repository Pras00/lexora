# ==============================================================================
# LEXORA — ENVIRONMENT VARIABLES TEMPLATE (NeonDB)
# Salin file ini menjadi .env.local dan isi dengan kredensial proyek Anda.
# ==============================================================================

# NeonDB PostgreSQL
# 1. Connection Pooling (Digunakan runtime aplikasi Next.js)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-endpoint-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Direct Connection (Digunakan migrasi skema & DDL)
DIRECT_URL=postgresql://neondb_owner:your_password@ep-your-endpoint.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Resend Email (Wajib untuk notifikasi email)
# Dapatkan dari: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Lexora Perpustakaan <onboarding@resend.dev>

# Cron Job Secret (Wajib untuk mengamankan route /api/cron/*)
# Buat string acak, contoh: openssl rand -base64 32
CRON_SECRET=lexora_super_secret_cron_token_2026

# App URL (Local development & Production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
